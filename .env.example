# Copy to .env (never committed) and fill in.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=incident_tracker

# Used by `npm run dev` on your machine (the compose app service builds its own).
DATABASE_URL=postgres://tracker:change-me-to-a-long-random-value@127.0.0.1:5432/incident_tracker

# Only honoured outside production (see src/lib/config.ts).
DEV_LOGIN_ENABLED=true

# Session cookie signing (32+ random characters). During rotation, move the old
# value to SESSION_SECRET_PREVIOUS so existing sessions stay valid.
SESSION_SECRET=change-me-to-at-least-32-random-characters
SESSION_SECRET_PREVIOUS=

# Development only: password given to the seeded users by `npm run seed`
# (12+ characters). Leave empty to use only the dev email login.
DEV_SEED_PASSWORD=

# Set to true only behind a trusted reverse proxy (then X-Forwarded-For is used for rate limits).
TRUST_PROXY=false
